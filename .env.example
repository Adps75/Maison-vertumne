# Variables d'environnement — Maison Vertumne
# Copier en .env.local et remplir les valeurs.

# Supabase — URL du projet (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — clé anon/publishable (Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — clé service_role / secrète (Settings > API > service_role)
SUPABASE_SECRET_KEY=

# Anthropic — clé API pour les appels vision
ANTHROPIC_API_KEY=

# Anthropic — modèle à utiliser (ex. claude-sonnet-4-20250514)
ANTHROPIC_MODEL=
