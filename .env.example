# Variables d'environnement — Atelier des Prés
# Copier en .env.local et remplir les valeurs.

# Supabase — URL du projet (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — clé anon/publishable (Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — clé service_role / secrète (Settings > API > service_role)
SUPABASE_SECRET_KEY=

# Anthropic — clé API pour les appels vision
ANTHROPIC_API_KEY=

# Anthropic — modèle à utiliser (ex. claude-sonnet-4-20250514)
ANTHROPIC_MODEL=

# Emails — "apercu" par défaut (pas d'envoi réel), "envoi" pour envoyer via Brevo
EMAIL_MODE=apercu

# Brevo — clé API transactionnelle (requis uniquement si EMAIL_MODE=envoi)
BREVO_API_KEY=

# Email de l'expéditeur (affiché dans les emails envoyés)
EMAIL_EXPEDITEUR=

# Email de l'administrateur (reçoit les notifications de nouveaux leads)
EMAIL_ADMIN=

# Secret pour les liens signés (diagnostic, etc.)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_LIENS=

# URL publique du site (utilisée pour les liens dans les emails et le PDF)
NEXT_PUBLIC_SITE_URL=
